{
  "name": "pi-sandbox-min",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 25000",
    "test:all": "bun test",
    "test:leasing": "bun run src/scripts/test-leasing.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.78.0",
    "@earendil-works/pi-ai": "^0.78.0",
    "express": "^5.2.1",
    "typebox": "^1.1.24"
  }
}
