# ── Pi / LLM provider ─────────────────────────────────────────────────────────
# The agent loop (src/pi/realPiClient.ts) talks to this provider. Defaults to
# Gemini. To use another provider, change PI_PROVIDER + PI_MODEL and set its key.
PI_PROVIDER=google
PI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=            # required — the service refuses to start without a key

# ── Kubernetes / sandbox ──────────────────────────────────────────────────────
SANDBOX_NAMESPACE=pi-sandbox
SANDBOX_CONTAINER=runner
SANDBOX_WORKDIR=/workspace

# ── Timeouts ──────────────────────────────────────────────────────────────────
QUEUE_MAX_WAIT_MS=15000     # max time a tool call waits in the FIFO queue
TOOL_TIMEOUT_MS=30000       # max time a single command may run in a pod
LEASE_TTL_SECONDS=45        # lease duration; an expired lease is reclaimable

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
SERVICE_INSTANCE_ID=api-1
